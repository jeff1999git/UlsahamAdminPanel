generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  username     String    @unique
  passwordHash String
  role         AdminRole
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  USER
}

model Event {
  id                       String              @id @default(auto()) @map("_id") @db.ObjectId
  name                     String
  slug                     String              @unique
  description              String
  bannerImageUrl           String
  bannerImageId            String
  venue                    String
  venueLink                String?
  date                     DateTime
  startTime                String
  endTime                  String
  isFree                   Boolean             @default(true)
  amount                   Float?
  earlyBirdAmount          Float?
  isEarlyBird              Boolean             @default(false)
  gstEnabled               Boolean             @default(false)
  platformFeeEnabled       Boolean             @default(true)
  isCompetition            Boolean             @default(false)
  participationType        ParticipationType   @default(INDIVIDUAL)
  groupExtraAmount         Float?
  competitionInstructions  String?
  competitionNotes         String?
  lastCompetitionNumber    Int                 @default(0)
  status                   EventStatus         @default(ANNOUNCED)
  capacity                 Int?
  featured                 Boolean             @default(false)
  couponCodes              CouponCode[]
  complimentaryCodes       ComplimentaryCode[]
  galleryImages            EventImage[]
  archivedParticipantCount Int                 @default(0)
  // What the event's bookings brought in, in paise, written when they are
  // pruned two weeks after the event so the dashboard revenue does not drop.
  // Unset on events pruned before it existed. Long, as one event's total can
  // pass the 32-bit limit (about ₹2.1 crore).
  archivedRevenuePaise     Int?                @db.Long
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  participants             Participant[]

  @@index([date])
  @@index([status])
}

enum EventStatus {
  ANNOUNCED
  PUBLISHED
  BOOKING_CLOSED
  CANCELLED
  COMPLETED
}

enum ParticipationType {
  INDIVIDUAL
  GROUP
  BOTH
}

// How a booking was settled. Set once when the booking is created, never by hand.
enum EntryType {
  PAID          // paid through Razorpay, on the site or at the staff counter
  COMPLIMENTARY // a complimentary code on the site, or added by staff
  FREE          // a free event booked on the site
}

type CouponCode {
  code     String
  discount Float
}

type ComplimentaryCode {
  code      String
  maxUses   Int
  usedCount Int
}

type EventImage {
  url String
  id  String
}

model Participant {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  eventId              String    @db.ObjectId
  event                Event     @relation(fields: [eventId], references: [id])
  name                 String
  phone                String
  email                String?
  age                  Int
  numberOfParticipants Int       @default(1)
  ticketCode           String    @unique
  competitionNumber    Int?
  isGroupRegistration  Boolean   @default(false)
  amountPaid           Boolean   @default(false)
  // Optional because bookings made before it existed lack it; entryStatusOf()
  // in src/lib/entry-type.ts infers one for those.
  entryType            EntryType?
  // Razorpay identifiers for paid bookings. paymentOrderId is the idempotency
  // key that lets payment/verify and the webhook safely replay the same order.
  paymentOrderId       String?
  paymentId            String?
  // The site's id for one free or complimentary registration submit: a retry
  // with the same id gets this booking back. Looked up together with eventId
  // (and phone), so it needs no index of its own.
  requestId            String?
  // What Razorpay charged for this booking (the order amount, in paise, fees
  // included). Unset on bookings made before it was recorded and on free or
  // complimentary ones; the dashboard estimates those it needs.
  amountPaidPaise      Int?
  attended             Boolean   @default(false)
  attendedAt           DateTime?
  enteredCount         Int       @default(0)
  registeredAt         DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // A person may hold several bookings (tickets) for the same event, so
  // phone/email are deliberately NOT unique per event — each booking gets its
  // own ticketCode.
  @@index([eventId])
  @@index([eventId, phone])
  @@index([phone])
  @@index([email])
  @@index([paymentOrderId])
}

type BrandPartner {
  id      String
  name    String
  logoUrl String
  logoId  String
}

// A Cloudinary image an event save, an event delete or a partner removal let
// go of. It is deleted once deleteAfter has passed, when no cached page can
// still show it (see src/services/housekeeping.service.ts).
type PendingImageDelete {
  publicId    String
  deleteAfter DateTime
}

model Settings {
  id                  String               @id @default(auto()) @map("_id") @db.ObjectId
  companyName         String               @default("Ulsaham Entertainments")
  address             String?
  email               String?
  phone               String?
  facebook            String?
  instagram           String?
  youtube             String?
  linkedin            String?
  brandPartners       BrandPartner[]
  // Missing on settings saved before it existed, which reads as an empty list.
  // No index, so it needs no `prisma db push`.
  pendingImageDeletes PendingImageDelete[]
  updatedAt           DateTime             @updatedAt
}

model ActivityLog {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  adminUsername String
  adminRole     String
  action        LogAction
  entity        String
  entityId      String?
  description   String
  metadata      Json?
  ipAddress     String
  createdAt     DateTime  @default(now())

  @@index([createdAt])
  @@index([adminUsername])
  @@index([action])
}

enum LogAction {
  LOGIN
  LOGOUT
  EVENT_CREATED
  EVENT_UPDATED
  EVENT_DELETED
  EVENT_STATUS_CHANGED
  PARTICIPANT_ADDED
  PARTICIPANT_UPDATED
  PARTICIPANT_DELETED
  ATTENDANCE_MARKED
  ATTENDANCE_UNMARKED
  SETTINGS_UPDATED
  ADMIN_CREATED
  ADMIN_UPDATED
  ADMIN_DELETED
  USER_CREATED
  USER_UPDATED
  USER_DELETED
}
