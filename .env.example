# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ulsaham?retryWrites=true&w=majority"

# ─── Auth.js v5 ───────────────────────────────────────────────────────────────
AUTH_SECRET="generate-with: openssl rand -base64 32"
# Optional on Vercel (the deployment URL is detected); if set, it must be this app's own address
NEXTAUTH_URL="https://ulsaham-admin-panel.vercel.app"

# ─── Super Admin Credentials (seeded into DB on first run) ───────────────────
# Additional admin accounts are created via the Admin Management UI by Super Admin
# Only `npm run db:seed` reads these; the deployed app does not need them.
SUPER_ADMIN_USERNAME="superadmin"
SUPER_ADMIN_PASSWORD="YourStrongSuperAdminPassword123!"

# ─── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# ─── Upstash Redis (Rate Limiting) ───────────────────────────────────────────
UPSTASH_REDIS_REST_URL="https://your-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ─── Razorpay (Payment Gateway) ──────────────────────────────────────────────
# Get these from https://dashboard.razorpay.com → Settings → API Keys
# Use test keys (rzp_test_...) for development, live keys for production
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
# Dashboard → Webhooks → payment.captured secret; without it the webhook answers 500
RAZORPAY_WEBHOOK_SECRET=""

# ─── Public Frontend (CORS) ──────────────────────────────────────────────────
# Browser origins allowed to call /api/public directly. The customer site goes
# through its own server-side proxy, so this only matters for direct callers.
FRONTEND_URL="https://www.ulsaaham.com"
# The customer site. The Razorpay webhook asks it to email the ticket for a
# booking it completes (signed with PROXY_SHARED_SECRET). Optional: defaults to
# https://www.ulsaaham.com.
SITE_URL="https://www.ulsaaham.com"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://ulsaham-admin-panel.vercel.app"
# Do not set NODE_ENV: Next.js and Vercel set it themselves for dev and builds.
# Shared with the customer site proxy so rate limits are per visitor (any long random string)
PROXY_SHARED_SECRET=""
# Set to "1" only while measuring: the public GET routes then add a Server-Timing
# header (rate limit, database phases, region). It exposes internal timings, so
# leave it unset otherwise.
# SERVER_TIMING="1"
