# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ulsaham?retryWrites=true&w=majority"

# ─── Auth.js v5 ───────────────────────────────────────────────────────────────
AUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="https://admin.ulsaham.com"

# ─── Super Admin Credentials (seeded into DB on first run) ───────────────────
# Additional admin accounts are created via the Admin Management UI by Super Admin
SUPER_ADMIN_USERNAME="superadmin"
SUPER_ADMIN_PASSWORD="YourStrongSuperAdminPassword123!"

# ─── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# ─── Upstash Redis (Rate Limiting) ───────────────────────────────────────────
UPSTASH_REDIS_REST_URL="https://your-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ─── Public Frontend (CORS) ──────────────────────────────────────────────────
FRONTEND_URL="https://ulsaham.com"

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://admin.ulsaham.com"
NODE_ENV="production"
